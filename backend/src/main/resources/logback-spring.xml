<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- コンソール出力（ローカル） -->
    <appender name="LOCAL" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- コンソール出力（CloudWatch） -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>[%thread] %-5level %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ローカル開発環境用の設定 -->
    <springProfile name="local">
        <logger name="com.cookingapp" level="DEBUG"/>
        <logger name="org.springframework.web" level="DEBUG"/>
        <logger name="software.amazon.awssdk" level="INFO"/>
        
        <root level="INFO">
            <appender-ref ref="LOCAL"/>
        </root>
    </springProfile>

    <!-- Dev/Prod環境用の設定 -->
    <springProfile name="!local">
        <!-- アプリケーションログ -->
        <logger name="com.cookingapp" level="INFO"/>
        
        <!-- Spring Framework -->
        <logger name="org.springframework.web" level="INFO"/>
        <logger name="org.springframework.boot" level="INFO"/>
        
        <!-- AWS SDK -->
        <logger name="software.amazon.awssdk" level="WARN"/>
        <logger name="software.amazon.awssdk.request" level="INFO"/>
        
        <!-- AWS Serverless Container -->
        <logger name="com.amazonaws.serverless" level="INFO"/>
        
        <!-- DynamoDB -->
        <logger name="software.amazon.awssdk.services.dynamodb" level="INFO"/>
        
        <!-- S3 -->
        <logger name="software.amazon.awssdk.services.s3" level="INFO"/>
        
        <!-- Cognito -->
        <logger name="software.amazon.awssdk.services.cognitoidentityprovider" level="INFO"/>
        
        <root level="WARN">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>
</configuration>
