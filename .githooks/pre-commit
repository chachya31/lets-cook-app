#!/bin/bash

# Git pre-commit hook
# このファイルを有効にするには: git config core.hooksPath .githooks

echo "🔍 Running pre-commit checks..."

# 変更されたファイルを取得
CHANGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

# バックエンドのチェック
if echo "$CHANGED_FILES" | grep -q "backend/.*\.java$"; then
    echo "📝 Checking backend files..."
    
    # System.out.printlnのチェック
    if git diff --cached --name-only --diff-filter=ACM | grep "backend/src/main.*\.java$" | xargs grep -l "System\.out\.println" 2>/dev/null; then
        echo "❌ Error: System.out.println found in production code"
        echo "Please use Logger instead"
        exit 1
    fi
    
    # ワイルドカードimportのチェック
    if git diff --cached --name-only --diff-filter=ACM | grep "backend/src/main.*\.java$" | xargs grep -l "^import .*\.\*;" 2>/dev/null; then
        echo "❌ Error: Wildcard import (.*) found"
        echo "Please use explicit imports instead of wildcard imports"
        exit 1
    fi
    
    # @Slf4jのチェック
    if git diff --cached --name-only --diff-filter=ACM | grep "backend/src/main.*\.java$" | xargs grep -l "@Slf4j" 2>/dev/null; then
        echo "❌ Error: @Slf4j annotation found"
        echo "Please use: private static final Logger log = LoggerFactory.getLogger(ClassName.class);"
        exit 1
    fi
    
    # publicフィールドのチェック（定数以外）
    if git diff --cached --name-only --diff-filter=ACM | grep "backend/src/main.*\.java$" | xargs grep -E "^\s+public\s+(?!static\s+final)[A-Z][a-zA-Z0-9<>,\s]*\s+[a-z]" 2>/dev/null; then
        echo "⚠️  Warning: public non-final field found"
        echo "Consider using private final instead"
    fi
    
    # バックエンドビルド
    echo "🔨 Building backend..."
    cd backend && ./gradlew.bat build -x test
    if [ $? -ne 0 ]; then
        echo "❌ Backend build failed"
        exit 1
    fi
    cd ..
fi

# フロントエンドのチェック
if echo "$CHANGED_FILES" | grep -q "frontend/.*\.\(ts\|tsx\|js\|jsx\)$"; then
    echo "📝 Checking frontend files..."
    
    # console.logのチェック（警告のみ）
    if git diff --cached --name-only --diff-filter=ACM | grep "frontend/src.*\.\(ts\|tsx\|js\|jsx\)$" | xargs grep -l "console\.log" 2>/dev/null; then
        echo "⚠️  Warning: console.log found in code"
    fi
    
    # ESLint
    echo "🔍 Running ESLint..."
    cd frontend && npm run lint
    if [ $? -ne 0 ]; then
        echo "❌ ESLint failed"
        exit 1
    fi
    cd ..
fi

echo "✅ All pre-commit checks passed!"
exit 0
