# Environment
ENVIRONMENT=local

# AWS
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# DynamoDB (LocalStack)
DYNAMODB_ENDPOINT=http://localhost:4566
DYNAMODB_USERS_TABLE=cooking-app-users-local
DYNAMODB_RECIPES_TABLE=cooking-app-recipes-local
DYNAMODB_RECIPE_INGREDIENTS_TABLE=cooking-app-recipe-ingredients-local
DYNAMODB_REVIEWS_TABLE=cooking-app-reviews-local
DYNAMODB_SCHEDULES_TABLE=cooking-app-schedules-local
DYNAMODB_SHOPPING_LISTS_TABLE=cooking-app-shopping-lists-local
DYNAMODB_CHAT_CONVERSATIONS_TABLE=cooking-app-chat-conversations-local
DYNAMODB_CHAT_MESSAGES_TABLE=cooking-app-chat-messages-local
DYNAMODB_INVENTORY_TABLE=cooking-app-inventory-local

# S3 (LocalStack)
S3_ENDPOINT=http://localhost:4566
S3_BUCKET=cooking-app-images-local

# Cognito (real AWS)
AWS_COGNITO_USER_POOL_ID=ap-northeast-1_aJ4JxScOo
AWS_COGNITO_CLIENT_ID=7e5mu77epiakek5jd9g6d5fvi

# Gemini
GEMINI_API_KEY=your-gemini-api-key

# Server
SERVER_PORT=8080
